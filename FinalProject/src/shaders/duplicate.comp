#version 460 core
#define USE_RECORDS
#define USE_COUNTS
#define USE_PAIRS
#include "common.glsl"

layout(local_size_x = 256) in;

uniform uint  splatCount;
uniform ivec2 viewport;
uniform int   tilesX;
uniform int   depthBits;    // number of low key bits that hold the depth (the tile index sits above them)
uniform float zNear;        // depth range of the splats
uniform float zFar;
uniform bool  tileMode;
uniform uint  capacity;

// Writes the (key, value) pairs of one splat: key = tile and depth, value = splat index.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= splatCount) return;
    uint slot = splatOffset[i];
    uint end  = min(splatOffset[i + 1u], capacity);
    if (slot >= end) return;

    // logarithmic depth code: the same relative resolution at every distance
    Record r = record[i];
    float t = clamp(log(r.colorDepth.a / zNear) / log(zFar / zNear), 0.0, 1.0);
    uint depthCode = uint(t * float((1u << depthBits) - 1u));

    if (!tileMode) {
        sortKey[slot] = depthCode;
        sortValue[slot] = i;
        return;
    }
    ivec4 tiles = tileRect(r.meanExtent.xy, r.meanExtent.zw, viewport);
    for (int y = tiles.y; y <= tiles.w; y++)
        for (int x = tiles.x; x <= tiles.z && slot < end; x++, slot++) {
            sortKey[slot] = (uint(y * tilesX + x) << depthBits) | depthCode;
            sortValue[slot] = i;
        }
}
