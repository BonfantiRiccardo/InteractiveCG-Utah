#version 460 core
#define USE_COUNTS
#define USE_PAIRS
#define USE_TILES
#include "common.glsl"

layout(local_size_x = 256) in;

uniform int depthBits;      // the tile index is above these bits of a key

// Finds where the pairs of each tile begin and end in the sorted list.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pairCount) return;
    uint tile = sortKey[i] >> depthBits;
    if (i == 0u || (sortKey[i - 1u] >> depthBits) != tile) tileRange[tile].x = i;
    if (i + 1u == pairCount || (sortKey[i + 1u] >> depthBits) != tile) tileRange[tile].y = i + 1u;
}
