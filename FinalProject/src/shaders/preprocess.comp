#version 460 core
#include "common.glsl"

layout(local_size_x = 256) in;

uniform uint  splatCount;
uniform mat4  view;             // world to view space (the camera looks down -z)
uniform vec3  cameraPosition;
uniform ivec2 viewport;         // render size in pixels
uniform float focal;            // focal length in pixels
uniform bool  tightBounds;      // box where alpha >= 1/255, instead of the 3 sigma square of 3DGS
uniform bool  tileMode;         // tile renderer: one pair per touched tile / quad renderer: one pair per splat

// Color of a splat seen along dir: spherical harmonics up to degree 3, as in 3DGS.
vec3 evaluateSH(uint splat, vec3 dir) {
    vec3 c[16];
    for (uint j = 0u; j < 8u; j++) {    // 3 uints hold 6 half floats: two RGB coefficients
        vec2 u0 = unpackHalf2x16(splatSH[splat * 24u + j * 3u]);
        vec2 u1 = unpackHalf2x16(splatSH[splat * 24u + j * 3u + 1u]);
        vec2 u2 = unpackHalf2x16(splatSH[splat * 24u + j * 3u + 2u]);
        c[2u * j]      = vec3(u0.x, u0.y, u1.x);
        c[2u * j + 1u] = vec3(u1.y, u2.x, u2.y);
    }
    float x = dir.x, y = dir.y, z = dir.z;
    float xx = x * x, yy = y * y, zz = z * z, xy = x * y, yz = y * z, xz = x * z;
    // The 16 SH basis functions are: 1, y, z, x, xy, yz, 2zz - xx - yy, xz, xx - yy,
    // y(3xx - yy), xyz, y(4zz - xx - yy), z(2zz - 3xx - 3yy), x(4zz - xx - yy), z(xx - yy), x(xx - 3yy)
    // The coefficients are standardized to be the same as those of 3DGS.
    vec3 color = 0.28209479 * c[0]
               - 0.48860251 * y * c[1] + 0.48860251 * z * c[2] - 0.48860251 * x * c[3]
               + 1.09254843 * xy * c[4] - 1.09254843 * yz * c[5] + 0.31539157 * (2.0 * zz - xx - yy) * c[6]
               - 1.09254843 * xz * c[7] + 0.54627422 * (xx - yy) * c[8]
               - 0.59004359 * y * (3.0 * xx - yy) * c[9] + 2.89061144 * xy * z * c[10]
               - 0.45704580 * y * (4.0 * zz - xx - yy) * c[11] + 0.37317633 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * c[12]
               - 0.45704580 * x * (4.0 * zz - xx - yy) * c[13] + 1.44530572 * z * (xx - yy) * c[14]
               - 0.59004359 * x * (xx - 3.0 * yy) * c[15];
    return max(color + 0.5, 0.0);
}

// Projects one splat: 2D mean, conic, bounding box and color, and counts the (key, value) pairs it needs.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= splatCount) return;
    splatOffset[i] = 0u;

    vec3  position = splatPosition[i].xyz;
    float opacity  = splatPosition[i].w;
    vec3  p = (view * vec4(position, 1.0)).xyz;
    float depth = -p.z;
    if (depth < Z_NEAR || opacity < ALPHA_MIN) return;

    // 2D covariance = J W S W^T J^T (EWA splatting): W rotates to view space, J is the Jacobian of the
    // projection to pixels. The clamp and the 0.3 pixel dilation are those of the 3DGS rasterizer.
    vec2 limit = 1.3 * 0.5 * vec2(viewport) / focal;
    vec2 q = clamp(p.xy / depth, -limit, limit) * depth;
    mat3 J = mat3(focal / depth, 0.0, 0.0,
                  0.0, focal / depth, 0.0,
                  focal * q.x / (depth * depth), focal * q.y / (depth * depth), 0.0);
    mat3 T = J * mat3(view);
    uint k = i * 6u;
    mat3 S = mat3(splatCovariance[k],      splatCovariance[k + 1u], splatCovariance[k + 2u],
                  splatCovariance[k + 1u], splatCovariance[k + 3u], splatCovariance[k + 4u],
                  splatCovariance[k + 2u], splatCovariance[k + 4u], splatCovariance[k + 5u]);
    mat3 cov = T * S * transpose(T);
    float a = cov[0][0] + 0.3, b = cov[0][1], c = cov[1][1] + 0.3;
    float det = a * c - b * b;
    if (det <= 0.0) return;

    vec2 extent;
    if (tightBounds) {
        // alpha = opacity * exp(-0.5 d^T conic d) >= 1/255 inside an ellipse (this is its bounding box)
        extent = sqrt(2.0 * log(opacity / ALPHA_MIN) * vec2(a, c));
    } else {
        float mid = 0.5 * (a + c);
        float lambda = mid + sqrt(max(0.1, mid * mid - det));
        extent = vec2(ceil(3.0 * sqrt(lambda)));
    }

    vec2 mean = focal * p.xy / depth + 0.5 * vec2(viewport - 1);
    ivec4 tiles = tileRect(mean, extent, viewport);
    if (tiles.z < tiles.x) return;

    record[i].meanExtent   = vec4(mean, extent);
    record[i].conicOpacity = vec4(c / det, -b / det, a / det, opacity);
    record[i].colorDepth   = vec4(evaluateSH(i, normalize(position - cameraPosition)), depth);
    splatOffset[i] = tileMode ? uint((tiles.z - tiles.x + 1) * (tiles.w - tiles.y + 1)) : 1u;
}
